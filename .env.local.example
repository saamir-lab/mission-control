# Mission Control V5 Environment Variables
# Copy this file to .env.local and fill in your actual values

# Linear API Key (required)
# Get from: https://linear.app/settings/api
LINEAR_API_KEY=lin_api_xxxxx

# Slack Bot Token for Rimo workspace (required)
# Get from: https://api.slack.com/apps -> OAuth & Permissions
SLACK_TOKEN_RIMO=xoxb-xxxxx

# Gmail via GOG CLI (required)
# Password for the keyring that stores Gmail credentials
GOG_KEYRING_PASSWORD=jarvis-keyring

# Gmail account to monitor (required)
GMAIL_ACCOUNT=123mithwanu@gmail.com